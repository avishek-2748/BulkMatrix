# ============================================================
# BULKMATRIX BACKEND — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/BulkMatrix?retryWrites=true&w=majority

# Authentication Security (Minimum 32 random characters)
JWT_SECRET=your_super_secret_jwt_key_here_bulkmatrix_2026

# Allowed Frontend Origins for CORS (NO trailing slash)
FRONTEND_URL=http://localhost:5173

# Client URL for Account Verification Emails
CLIENT_URL=http://localhost:5173

# Machine Learning Engine Microservice (Optional: defaults to http://localhost:8000)
ML_API_URL=http://localhost:8000

# SMTP Mail Server (Optional: defaults to console logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BulkMatrix Support" <noreply@bulkmatrix.com>
