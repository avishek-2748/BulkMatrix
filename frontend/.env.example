# Backend API Gateway URL (Include /api path, NO trailing slash)
VITE_API_BASE_URL=http://localhost:5000/api

# Currency Analytics Default Exchange Rate (Optional, defaults to 83.5)
VITE_USD_INR_RATE=83.50
